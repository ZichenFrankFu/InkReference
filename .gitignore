# Local credentials. Commit examples, never populated environment files.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# User-owned sources, uploads, cleaning versions and portable backups.
# Runtime defaults live outside the checkout; these cover local overrides.
/data/
/local-data/
/user-data/
/private/
imports/
uploads/
originals/
raw-texts/
fulltexts/
full_texts/
cleaned/
text_versions/
exports/
backups/
restored_projects/
*.bak
*.backup
*.backup.zip
*-backup.zip
backup-*.zip
# Uploaded books and material CSVs accidentally copied to the checkout root.
*.epub
*.pdf
*.docx
*.srt
*.txt
*.csv
*.xlsx
*.xlsm
*.xls
!requirements*.txt
!third_party/*LICENSE*.txt

